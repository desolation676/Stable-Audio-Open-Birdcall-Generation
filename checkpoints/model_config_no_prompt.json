{
    "model_type": "diffusion_cond",
    "sample_size": 524288,
    "sample_rate": 44100,
    "audio_channels": 2,
    "model": {
        "pretransform": {
            "type": "autoencoder",
            "iterate_batch": true,
            "config": {
                "encoder": {
                    "type": "oobleck",
                    "requires_grad": false,
                    "config": {
                        "in_channels": 2,
                        "channels": 128,
                        "c_mults": [1, 2, 4, 8, 16],
                        "strides": [2, 4, 4, 8, 8],
                        "latent_dim": 128,
                        "use_snake": true
                    }
                },
                "decoder": {
                    "type": "oobleck",
                    "config": {
                        "out_channels": 2,
                        "channels": 128,
                        "c_mults": [1, 2, 4, 8, 16],
                        "strides": [2, 4, 4, 8, 8],
                        "latent_dim": 64,
                        "use_snake": true,
                        "final_tanh": false
                    }
                },
                "bottleneck": {
                    "type": "vae"
                },
                "latent_dim": 64,
                "downsampling_ratio": 2048,
                "io_channels": 2
            }
        },
        "conditioning": {
    "configs": [
        {
            "id": "seconds_start",
            "type": "number",
            "config": { "min_val": 0, "max_val": 512 }
        },
        {
            "id": "seconds_total",
            "type": "number",
            "config": { "min_val": 0, "max_val": 512 }
        },
        {
            "id": "species_id",
            "type": "int",
            "config": { "min_val": 0, "max_val": 20 }
        }
    ],
    "cond_dim": 768
},
"diffusion": {
    "cross_attention_cond_ids": ["seconds_start", "seconds_total", "species_id"],
    "global_cond_ids": ["seconds_start", "seconds_total"],
    "type": "dit",
    "config": {
        "io_channels": 64,
        "embed_dim": 1536,
        "depth": 24,
        "num_heads": 24,
        "cond_token_dim": 768,
        "global_cond_dim": 1536,
        "project_cond_tokens": false,
        "transformer_type": "continuous_transformer"
    }
},
        "io_channels": 64
    },
    "training": {
        "use_ema": true,
        "log_loss_info": false,
        "optimizer_configs": {
            "diffusion": {
                "optimizer": {
                    "type": "AdamW",
                    "config": {
                        "lr": 1e-5,
                        "betas": [0.9, 0.999],
                        "weight_decay": 1e-3
                    }
                },
                "scheduler": {
                    "type": "InverseLR",
                    "config": {
                        "inv_gamma": 1000000,
                        "power": 0.5,
                        "warmup": 0.99
                    }
                }
            }
        },
        "demo": {
            "demo_every": 1000,
            "demo_steps": 250,
            "num_demos": 4,
            "demo_cond": [
                {
                    "species_id": 0,
                    "seconds_start": 0,
                    "seconds_total": 12
                },
                {
                    "species_id": 1,
                    "seconds_start": 0,
                    "seconds_total": 12
                },
                {
                    "species_id": 2,
                    "seconds_start": 0,
                    "seconds_total": 12
                },
                {
                    "species_id": 3,
                    "seconds_start": 0,
                    "seconds_total": 12
                }
            ],
            "demo_cfg_scales": [3, 6, 9]
        }
    }
}